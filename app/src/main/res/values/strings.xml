    <string name="onboarding_media_body">Lets Dupe Digger find duplicate media anywhere on this device.</string>
    <string name="onboarding_all_files_title">Deep scan (optional)</string>
    <string name="onboarding_all_files_body">Also finds documents, archives and other files outside the folders you pick. This uses All files access, which you turn on in Settings.</string>
    <string name="onboarding_privacy">Everything stays on this device. You can still scan folders you pick without either permission.</string>
